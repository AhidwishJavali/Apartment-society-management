generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ResidentType {
  OWNER
  TENANT
}

enum VehicleType {
  CAR
  BIKE
}

enum ParkingStatus {
  ALLOCATED
  AVAILABLE
}

enum PaymentStatus {
  PAID
  PENDING
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum UserRole {
  ADMIN
  RESIDENT
  MAINTENANCE
  SECURITY
}

model Apartment {
  id        Int      @id @default(autoincrement()) @map("apartment_id")
  block     String   @db.VarChar(10)
  floorNo   Int      @map("floor_no")
  flatNo    String   @map("flat_no") @db.VarChar(10)
  bhk       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  residents Resident[]
  parking   ParkingSpace[]
  payments  MaintenancePayment[]

  @@unique([block, flatNo])
  @@map("Apartment")
}

// One row per person per flat (a "residency"). The same person may own or rent several flats,
// so contact details are not unique, and one login account can be linked to several rows.
model Resident {
  id           Int          @id @default(autoincrement()) @map("resident_id")
  apartmentId  Int          @map("apartment_id")
  accountId    Int?         @map("account_id")
  name         String       @db.VarChar(100)
  phone        String?      @db.VarChar(15)
  email        String?      @db.VarChar(100)
  residentType ResidentType @map("resident_type")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  apartment  Apartment    @relation(fields: [apartmentId], references: [id])
  vehicles   Vehicle[]
  complaints Complaint[]
  account    UserAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([accountId, apartmentId]) // an account has at most one residency per flat
  @@index([apartmentId])
  @@index([phone])
  @@index([email])
  @@map("Resident")
}

model Staff {
  id        Int      @id @default(autoincrement()) @map("staff_id")
  name      String   @db.VarChar(100)
  role      String   @db.VarChar(50)
  phone     String?  @unique @db.VarChar(15)
  salary    Decimal? @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  complaints Complaint[]
  account    UserAccount?

  @@index([role])
  @@map("Staff")
}

// apartment_id is nullable: an AVAILABLE slot belongs to no flat.
model ParkingSpace {
  id          Int           @id @default(autoincrement()) @map("parking_id")
  apartmentId Int?          @map("apartment_id")
  slotNumber  String        @unique @map("slot_number") @db.VarChar(10)
  vehicleType VehicleType   @map("vehicle_type")
  status      ParkingStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  apartment Apartment? @relation(fields: [apartmentId], references: [id])
  vehicle   Vehicle?

  @@index([apartmentId])
  @@index([status])
  @@map("ParkingSpace")
}

model Vehicle {
  id            Int         @id @default(autoincrement()) @map("vehicle_id")
  residentId    Int         @map("resident_id")
  parkingId     Int?        @unique @map("parking_id")
  vehicleNumber String      @unique @map("vehicle_number") @db.VarChar(20)
  vehicleType   VehicleType @map("vehicle_type")
  brand         String?     @db.VarChar(50)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  resident Resident      @relation(fields: [residentId], references: [id])
  parking  ParkingSpace? @relation(fields: [parkingId], references: [id])

  @@index([residentId])
  @@map("Vehicle")
}

model MaintenancePayment {
  id           Int           @id @default(autoincrement()) @map("payment_id")
  apartmentId  Int           @map("apartment_id")
  amount       Decimal       @db.Decimal(10, 2)
  paymentMonth String        @map("payment_month") @db.VarChar(20)
  paymentDate  DateTime?     @map("payment_date") @db.Date
  status       PaymentStatus
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  apartment Apartment @relation(fields: [apartmentId], references: [id])

  @@unique([apartmentId, paymentMonth])
  @@index([status])
  @@map("MaintenancePayment")
}

model Complaint {
  id            Int             @id @default(autoincrement()) @map("complaint_id")
  residentId    Int             @map("resident_id")
  staffId       Int?            @map("staff_id")
  category      String          @db.VarChar(50)
  description   String?         @db.VarChar(255)
  complaintDate DateTime        @map("complaint_date") @db.Date
  status        ComplaintStatus @default(OPEN)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  resident Resident @relation(fields: [residentId], references: [id])
  staff    Staff?   @relation(fields: [staffId], references: [id])

  @@index([residentId])
  @@index([staffId])
  @@index([status])
  @@map("Complaint")
}

// Supporting table for real authentication. Admins are standalone; RESIDENT accounts are linked
// from one or more Resident rows (one per flat); staff accounts link to exactly one Staff row.
model UserAccount {
  id                 Int       @id @default(autoincrement()) @map("user_id")
  username           String    @unique @db.VarChar(50)
  email              String    @unique @db.VarChar(100)
  passwordHash       String    @map("password_hash") @db.VarChar(100)
  role               UserRole
  staffId            Int?      @unique @map("staff_id")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  residencies Resident[]
  staff       Staff?          @relation(fields: [staffId], references: [id])
  request     AccountRequest?

  @@map("UserAccount")
}

// Failed sign-in counter shared by every server process.
model LoginAttempt {
  identifier String   @id @db.VarChar(100)
  failures   Int      @default(0)
  resetAt    DateTime @map("reset_at")

  @@map("LoginAttempt")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Sign-up requests from the public form; an admin approves (creating the UserAccount) or rejects.
model AccountRequest {
  id               Int           @id @default(autoincrement()) @map("request_id")
  fullName         String        @map("full_name") @db.VarChar(100)
  username         String        @db.VarChar(50)
  email            String        @db.VarChar(100)
  passwordHash     String        @map("password_hash") @db.VarChar(100)
  requestedRole    UserRole      @map("requested_role")
  phone            String?       @db.VarChar(15)
  flatInfo         String?       @map("flat_info") @db.VarChar(50)
  message          String?       @db.VarChar(300)
  status           RequestStatus @default(PENDING)
  reviewedByUserId Int?          @map("reviewed_by_user_id")
  reviewedAt       DateTime?     @map("reviewed_at")
  reviewNote       String?       @map("review_note") @db.VarChar(300)
  createdAccountId Int?          @unique @map("created_account_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  createdAccount UserAccount? @relation(fields: [createdAccountId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([username])
  @@index([email])
  @@map("AccountRequest")
}
